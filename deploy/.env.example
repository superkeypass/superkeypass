# Public hostname of the vault. Caddy gets the TLS certificate for it.
VAULT_HOST=vault.example.com

# Vaultwarden admin panel token. Generate: openssl rand -base64 48
VW_ADMIN_TOKEN=

# Companion admin password (HTTP Basic, any username). Generate: openssl rand -base64 32
SKP_ADMIN_TOKEN=

# Alert email (STARTTLS on 587). Also used by Vaultwarden for invites.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional push alerts: an ntfy topic nobody can guess, e.g. https://ntfy.sh/skp-<random>
SKP_NTFY_URL=
